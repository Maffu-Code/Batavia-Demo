# Batavia Lab. Salin ke .env hanya jika belum ada. Jangan commit .env.
MODE=lab
PORT=6080
# Relatif terhadap prisma/schema.prisma: backend-lab/prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-ini-sebelum-run-pertama

# Opsional; nilai berikut sudah menjadi default.
# JWT_EXPIRES_IN=12h
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_MAX=5
# PRIVATE_STORAGE_DIR=./storage-private
# Origin localhost dan 127.0.0.1 pada port 5173 otomatis diizinkan di lab.
# CORS_ORIGIN=
# DEMO_PASSWORD=  # Pilih sandi demo >=12 karakter sebelum seed pertama bila perlu.
