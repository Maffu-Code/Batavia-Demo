{
  "name": "memoria-lab-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend REST API Memoria -- versi lab (SQLite, dev-only)",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset --force --skip-seed",
    "prisma:studio": "prisma studio",
    "seed": "node scripts/seed-demo.js",
    "seed:katalog": "node scripts/seed-katalog.js",
    "uji": "node ../scripts/lab.cjs --test"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.2",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
